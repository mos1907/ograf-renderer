  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "typescript": "^5.5.0"
  }
